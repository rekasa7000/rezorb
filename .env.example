# Rezorb environment template. Copy to .env.local and fill in. See docs/DEPLOYMENT.md.
# Locally only DATABASE_URL, BETTER_AUTH_SECRET and GRANT_SECRET are needed; everything
# else has a development fallback (disk storage, polling, console email, in-memory limits).

# ── Database (Neon Postgres) ───────────────────────────────────────────
DATABASE_URL=postgres://rezorb:rezorb@localhost:5432/rezorb
DATABASE_URL_UNPOOLED=postgres://rezorb:rezorb@localhost:5432/rezorb

# ── Auth ───────────────────────────────────────────────────────────────
BETTER_AUTH_SECRET=            # openssl rand -base64 32
GRANT_SECRET=                  # openssl rand -base64 32
GRANT_SECRET_PREV=             # only while rotating
# Canonical public origin. REQUIRED in production on a custom domain (read at runtime).
BETTER_AUTH_URL=http://localhost:3000

# ── Files (Cloudflare R2) — required in production ─────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=rezorb-dev

# ── Realtime (Ably) — server only, never NEXT_PUBLIC_ ──────────────────
ABLY_API_KEY=

# ── Rate limiting (Upstash Redis) ──────────────────────────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Email (Resend) — required in production ────────────────────────────
RESEND_API_KEY=
EMAIL_FROM="Rezorb <orbit@mail.rezorb.app>"

# ── Cron ───────────────────────────────────────────────────────────────
CRON_SECRET=                   # the cron route is closed without it

# ── Optional ───────────────────────────────────────────────────────────
# NEXT_PUBLIC_APP_URL=         # last-resort fallback only (inlined at build time)
# LOG_LEVEL=info
