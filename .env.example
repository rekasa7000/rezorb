# Rezorb environment template. Copy to .env.local and fill in.
# See docs/DEPLOYMENT.md for where each value comes from.

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database (Neon Postgres)
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
GRANT_SECRET=
GRANT_SECRET_PREV=

# Storage (Cloudflare R2)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=rezorb-dev

# Realtime (Ably) — server only, never NEXT_PUBLIC_
ABLY_API_KEY=

# Rate limiting (Upstash Redis)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Email (Resend)
RESEND_API_KEY=
EMAIL_FROM="Rezorb <orbit@mail.rezorb.app>"

# Cron
CRON_SECRET=

# Observability
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
