    "@upstash/ratelimit": "^2.2.1",
    "@upstash/redis": "^1.41.0",
    "ably": "^2.30.0",
    "better-auth": "^1.7.27",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
